# Copy this file to .env and fill in real values. Never put real creds here.
# Slack incoming webhook (see README step 1)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Burner X account - used by login.py only, once
X_USERNAME=my_burner_handle
X_EMAIL=burner@example.com
X_PASSWORD=supersecret

# Optional
QUERY=claude referral
POLL_SECONDS=60
RESULT_COUNT=25
MAX_AGE_MINUTES=30
STATE_DIR=.
PORT=7860
# HEADLESS=0             # watch the browser while debugging
# RUN_ONCE=1             # single cycle - for testing
# HEALTH=0               # skip the health port (CI sets this)
# MAX_RUNTIME_SECONDS=0  # exit after N seconds for handoff; CI sets 20700
# STORAGE_STATE_B64=     # session as base64, for hosts with no persistent disk
